# PostgreSQL 连接（docker compose up -d 后可用默认值）
DATABASE_URL=postgres://openmaic:openmaic@localhost:5434/openmaic

# OpenAI 兼容 LLM 配置（必填 LLM_API_KEY）
# DeepSeek 示例:  LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
# Kimi 示例:      LLM_BASE_URL=https://api.moonshot.cn/v1   LLM_MODEL=moonshot-v1-8k
# GLM 示例:       LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4 LLM_MODEL=glm-4-flash
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat


# 参考资料模块：本地 PaddleOCR 服务（可选，扫描版 PDF / 图片识别用）
# 启动方法见 scripts/paddleocr_server.py，配置后重启应用生效
# OCR_SERVICE_URL=http://127.0.0.1:8900/ocr
